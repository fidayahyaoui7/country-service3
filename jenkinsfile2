pipeline {
    agent any

    tools {
        maven 'M2_HOME'
    }

    stages {

        stage('Checkout code') {
            steps {
                git branch: 'main', url: 'https://github.com/fidayahyaoui7/country-service3.git'
            }
        }

        stage('Build maven') {
            steps {
                sh 'mvn clean install'
            }
        }

        stage('Build Dockerfile') {
            steps {
                sh 'docker build . -t my-country-service3:$BUILD_NUMBER'

                withCredentials([string(credentialsId: 'dockerhub-pwd', variable: 'dockerhubpwd')]) {
                    sh 'echo $dockerhubpwd | docker login -u fidayahyaoui --password-stdin'
                }

                sh 'docker tag my-country-service3:$BUILD_NUMBER fidayahyaoui/my-country-service3:$BUILD_NUMBER'
                sh 'docker push fidayahyaoui/my-country-service3:$BUILD_NUMBER'
            }
        }

        stage('Deploy micro-service') {
            steps {
                sh 'docker rm -f country-service3 || true'
                sh 'docker run -d --name country-service3 -p 8082:8082 my-country-service3:$BUILD_NUMBER'
            }
        }
    }
}
