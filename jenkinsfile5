
pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'M2_HOME'
    }

    options {
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/fidayahyaoui7/country-service3.git'
            }
        }

        stage('Build Maven') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Deploy using Ansible') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'ansible_vault_pass',
                        variable: 'VAULT_PASS'
                    )
                ]) {
                    sh '''
                        set -e
                        trap 'rm -f vault_pass.txt' EXIT

                        echo "$VAULT_PASS" > vault_pass.txt

                        ansible-playbook \
                          -i hosts \
                          playbookCICD1.yml \
                          --vault-password-file vault_pass.txt
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }

        success {
            echo 'SUCCESS: Application deployed successfully!'
        }

        failure {
            echo 'FAILURE: Pipeline execution failed!'
        }
    }
}
